{
  "name": "kapplus",
  "version": "0.1.0",
  "description": "Compile and publish asset-backed ProcessingJS projects to Khan Academy",
  "homepage": "https://b1fr0st.github.io/kapplus/",
  "repository": { "type": "git", "url": "https://github.com/B1Fr0st/kapplus.git" },
  "keywords": ["khan-academy", "processingjs", "webgl", "game-development"],
  "type": "module",
  "bin": {
    "kapplus": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser-session": {
      "types": "./dist/browser-session.d.ts",
      "default": "./dist/browser-session.js"
    },
    "./browser-types": {
      "types": "./dist/browser-types.d.ts",
      "default": "./dist/browser-types.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs/networking.md",
    "workers/network-proxy"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:install": "node scripts/test-install.mjs",
    "test:khan": "node scripts/test-khan-preview.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@types/node": "^24.5.2",
    "chokidar": "^4.0.3",
    "esbuild": "^0.25.0",
    "playwright": "^1.63.0",
    "terser": "^5.51.2",
    "typescript": "^5.9.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
